#!/usr/bin/env ruby
# frozen_string_literal: true

# Copyright (c) 2025 SignalWire
#
# Licensed under the MIT License.
# See LICENSE file in the project root for full license information.

#
# wire-relay-dump — the Ruby port's WIRE-RELAY dump program for the cross-port
# relay differ (porting-sdk/scripts/diff_port_wire_relay.py).
#
# It captures, for each wire_relay_corpus case, the observable RELAY artifact:
#   - verb   : the {method, params} JSON-RPC frame a Call verb (or an Action
#     control-op) hands to the wire.
#   - client : the {method, params} frame a RelayClient call (execute / dial /
#     send_message) sends.
#   - event  : the decoded fields a typed event decoder extracts from a payload.
#
# It prints ONE JSON object mapping case-id -> artifact to stdout; the differ
# canonicalizes both sides (normalizing the random control_id to a sentinel) and
# byte-compares against the Python oracle. Only stdout carries JSON.
#
# Frame capture (interpreted-port idiom): a recording subclass of Call overrides
# +_execute+ and a recording subclass of RelayClient overrides +execute+, each
# recording the {method, params} frame it would send and returning a canned
# success — no real WebSocket is involved. Event decoding is pure. This mirrors
# how the differ intercepts Python's Call._execute / RelayClient.execute (the Go
# reference stands up a mock WS instead — same observable frames).
#
# Run from the signalwire-ruby repo root:
#
#   bin/wire-relay-dump      (or:  ruby bin/wire-relay-dump)

require 'json'

# Keep stdout PURE JSON: the behavioral differ does json.loads(proc.stdout), so any stray
# byte written to stdout during require/agent-init (a gem notice, a banner, a logger that
# lands on stdout in some environments) corrupts the parse ("Expecting value: line 1 col 1").
# Save the real stdout, point $stdout at stderr for all setup, and restore only to emit JSON.
REAL_STDOUT = $stdout.dup
$stdout.reopen($stderr)
require_relative '../lib/signalwire'
require_relative '../lib/signalwire/relay/call'
require_relative '../lib/signalwire/relay/action'
require_relative '../lib/signalwire/relay/client'
require_relative '../lib/signalwire/relay/relay_event'

R = SignalWire::Relay

NODE = 'node-abc'
CALL = 'call-xyz'
CID  = 'ctl-123'

# RecordingClient overrides execute to capture the {method, params} frame at the
# CLIENT-SEND boundary — the Ruby mirror of the differ's _RecordingClient. A Call
# verb is only observed if it actually transmits (Call#_execute -> @client.execute):
# a verb that builds a frame but never reaches the client records NOTHING here and
# fails the differ. This is the transmission-observation contract.
class RecordingClient < R::Client
  attr_reader :frames

  def initialize(**kwargs)
    @frames = []
    super
  end

  def execute(method, params = {})
    @frames << { 'method' => method, 'params' => params }
    return { 'code' => '200', 'message' => 'Dialing' } if method == 'calling.dial'
    return { 'code' => '200', 'message_id' => 'msg-1' } if method == 'messaging.send'

    { 'code' => '200' }
  end
end

# new_call builds a REAL Call attached to a recording client, so a verb's frame is
# captured only when the verb transmits through Call#_execute -> @client.execute
# (not from any in-memory record). Frames are read from the call's client.
def new_call
  client = RecordingClient.new(project: 'proj-1', token: 'tok-1', host: 'mock')
  call = R::Call.new(client, call_id: CALL, node_id: NODE, project_id: 'proj-1',
                             context: 'ctx', state: 'answered')
  # Expose the client's captured frames on the call so the corpus reads
  # c.frames.last as before (now sourced from the client-send boundary).
  call.define_singleton_method(:frames) { client.frames }
  call
end

def frame(method, params)
  { 'method' => method, 'params' => params }
end

out = {}

# ================================================================
# Call command verbs — capture the frame each verb emits
# ================================================================

# relay_play
c = new_call
c.play([{ 'type' => 'audio', 'params' => { 'url' => 'https://x/a.mp3' } }], volume: 5.0, control_id: CID)
out['relay_play'] = c.frames.last

# relay_play_tts
c = new_call
c.play_tts('Hello world', voice: 'en-US-Neural')
out['relay_play_tts'] = c.frames.last

# relay_record
c = new_call
c.record(audio: { 'format' => 'mp3', 'beep' => true }, control_id: CID)
out['relay_record'] = c.frames.last

# relay_connect
c = new_call
c.connect(devices: [[{ 'type' => 'phone', 'params' => { 'to_number' => '+15551112222' } }]],
          ringback: [{ 'type' => 'ringtone', 'params' => { 'name' => 'us' } }],
          tag: 'leg-1', max_duration: 3600)
out['relay_connect'] = c.frames.last

# relay_collect
c = new_call
c.collect({ 'digits' => { 'max' => 4, 'terminators' => '#' },
            'speech' => { 'language' => 'en-US' },
            'initial_timeout' => 5.0, 'partial_results' => true }, control_id: CID)
out['relay_collect'] = c.frames.last

# relay_prompt (prompt_tts -> play_and_collect)
c = new_call
c.prompt_tts('Enter your PIN', { 'digits' => { 'max' => 4 } }, voice: 'en-US-Neural')
out['relay_prompt'] = c.frames.last

# relay_detect
c = new_call
c.detect({ 'type' => 'machine', 'params' => { 'initial_timeout' => 4.0 } }, timeout: 30.0, control_id: CID)
out['relay_detect'] = c.frames.last

# relay_detect_amd
c = new_call
c.detect_answering_machine(initial_timeout: 4.0, machine_words_threshold: 6, timeout: 30.0)
out['relay_detect_amd'] = c.frames.last

# relay_tap (Ruby exposes the tap verb as tap_audio; wire frame is calling.tap)
c = new_call
c.tap_audio({ 'type' => 'audio', 'params' => { 'direction' => 'both' } },
            device: { 'type' => 'ws', 'params' => { 'uri' => 'wss://x/tap' } }, control_id: CID)
out['relay_tap'] = c.frames.last

# relay_send_fax
c = new_call
c.send_fax(document: 'https://x/doc.pdf', identity: '+15550001111', header_info: 'Hdr', control_id: CID)
out['relay_send_fax'] = c.frames.last

# relay_live_transcribe (action MUST be wrapped as params.action)
c = new_call
c.live_transcribe(action: { 'start' => { 'lang' => 'en' } })
out['relay_live_transcribe'] = c.frames.last

# relay_live_translate (action MUST be wrapped as params.action; status_url sibling)
c = new_call
c.live_translate(action: { 'start' => { 'from_lang' => 'en', 'to_lang' => 'es' } },
                 status_url: 'https://x/cb')
out['relay_live_translate'] = c.frames.last

# ---- control-ops (Action methods) ----
# relay_play_stop
c = new_call
pa = c.play([{ 'type' => 'audio', 'params' => { 'url' => 'https://x/a.mp3' } }], control_id: CID)
pa.stop
out['relay_play_stop'] = c.frames.last

# relay_play_pause
c = new_call
pa = c.play([{ 'type' => 'audio', 'params' => { 'url' => 'https://x/a.mp3' } }], control_id: CID)
pa.pause(behavior: 'silence')
out['relay_play_pause'] = c.frames.last

# relay_record_resume
c = new_call
ra = c.record(audio: { 'format' => 'mp3' }, control_id: CID)
ra.resume
out['relay_record_resume'] = c.frames.last

# relay_play_volume
c = new_call
pa = c.play([{ 'type' => 'audio', 'params' => { 'url' => 'https://x/a.mp3' } }], control_id: CID)
pa.volume(3.5)
out['relay_play_volume'] = c.frames.last

# ================================================================
# RelayClient-level frames
# ================================================================
def new_client
  RecordingClient.new(project: 'proj-1', token: 'tok-1', host: 'mock')
end

# relay_client_execute
cl = new_client
cl.execute('calling.answer', { 'node_id' => NODE, 'call_id' => CALL })
out['relay_client_execute'] = cl.frames.last

# relay_send_message
cl = new_client
cl.send_message(to_number: '+15551112222', from_number: '+15553334444', body: 'hi', tags: ['t1'])
out['relay_send_message'] = cl.frames.find { |f| f['method'] == 'messaging.send' }

# relay_dial (drive dial in a thread; resolve it by feeding the answered event)
cl = new_client
dial_thread = Thread.new do
  cl.dial([[{ 'type' => 'phone', 'params' => { 'to_number' => '+15551112222' } }]],
          tag: 'dial-1', max_duration: 600)
rescue StandardError
  nil
end
# Let dial register its pending future + send the calling.dial frame, then resolve.
sleep(0.05)
cl.send(
  :_handle_event,
  'params' => {
    'event_type' => 'calling.call.dial',
    'params' => {
      'tag' => 'dial-1', 'dial_state' => 'answered',
      'call' => { 'call_id' => CALL, 'node_id' => NODE }
    }
  }
)
dial_thread.join(2)
out['relay_dial'] = cl.frames.find { |f| f['method'] == 'calling.dial' }

# ================================================================
# Typed event decoders
# ================================================================
def class_basename(obj)
  obj.class.name.split('::').last
end

# relay_evt_queue
q = R::QueueEvent.from_payload(
  'event_type' => 'calling.call.queue',
  'params' => { 'call_id' => CALL, 'control_id' => CID, 'status' => 'waiting',
                'id' => 'q-42', 'name' => 'support', 'position' => 3, 'size' => 10 }
)
out['relay_evt_queue'] = {
  'control_id' => q.control_id, 'status' => q.status,
  'queue_id' => q.queue_id, 'queue_name' => q.queue_name,
  'position' => q.position, 'size' => q.size
}

# relay_evt_record
rec = R::RecordEvent.from_payload(
  'event_type' => 'calling.call.record',
  'params' => { 'call_id' => CALL, 'control_id' => CID, 'state' => 'finished',
                'record' => { 'url' => 'https://x/rec.mp3', 'duration' => 12.5, 'size' => 4096 } }
)
out['relay_evt_record'] = {
  'control_id' => rec.control_id, 'state' => rec.state,
  'url' => rec.url, 'duration' => rec.duration, 'size' => rec.size
}

# relay_evt_state_dispatch (parse_event -> CallStateEvent)
obj = R.parse_event(
  'event_type' => 'calling.call.state',
  'params' => { 'call_id' => CALL, 'call_state' => 'answered', 'direction' => 'inbound', 'end_reason' => '' }
)
out['relay_evt_state_dispatch'] = {
  '_class' => class_basename(obj),
  'call_id' => obj.call_id, 'call_state' => obj.call_state, 'direction' => obj.direction
}

# relay_evt_collect
col = R::CollectEvent.from_payload(
  'event_type' => 'calling.call.collect',
  'params' => { 'call_id' => CALL, 'control_id' => CID, 'state' => 'finished',
                'result' => { 'type' => 'digit', 'params' => { 'digits' => '1234' } },
                'final' => true }
)
out['relay_evt_collect'] = {
  'control_id' => col.control_id, 'state' => col.state,
  'result' => col.result, 'final' => col.final
}

REAL_STDOUT.puts(JSON.generate(out))
REAL_STDOUT.flush
